{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "type": "object",
  "required": [
    "formatVersion",
    "nodes",
    "edges"
  ],
  "additionalProperties": false,
  "properties": {
    "formatVersion": {
      "const": 1
    },
    "nodes": {
      "type": "array",
      "items": {
        "type": "object",
        "required": [
          "id",
          "type",
          "label"
        ],
        "additionalProperties": false,
        "properties": {
          "id": {
            "type": "string",
            "minLength": 1
          },
          "type": {
            "enum": [
              "system",
              "capability",
              "command",
              "data",
              "invariant",
              "symbol",
              "test",
              "surface"
            ]
          },
          "label": {
            "type": "string",
            "minLength": 1
          },
          "aliases": {
            "type": "array",
            "items": {
              "type": "string"
            }
          },
          "references": {
            "type": "array",
            "items": {
              "type": "string"
            }
          },
          "binding": {
            "type": "object",
            "required": [
              "path",
              "symbol"
            ],
            "additionalProperties": false,
            "properties": {
              "path": {
                "type": "string"
              },
              "symbol": {
                "type": "string"
              }
            }
          }
        }
      }
    },
    "edges": {
      "type": "array",
      "items": {
        "type": "object",
        "required": [
          "from",
          "to",
          "relation",
          "provenance",
          "evidence"
        ],
        "additionalProperties": false,
        "properties": {
          "from": {
            "type": "string"
          },
          "to": {
            "type": "string"
          },
          "relation": {
            "enum": [
              "belongs_to",
              "implements",
              "invokes",
              "writes",
              "constrained_by",
              "verified_by",
              "depends_on"
            ]
          },
          "provenance": {
            "enum": [
              "source_review",
              "inferred"
            ]
          },
          "evidence": {
            "type": "string"
          }
        }
      }
    }
  }
}
