<!doctype html>
<html lang="zh-CN">
<meta charset="utf-8"><meta name="viewport" content="width=device-width,initial-scale=1">
<title>__REVIEW_TITLE__</title>
<style>
:root{--ink:#1d2d44;--muted:#64748b;--line:#dee5ee;--blue:#1262db;--paper:#f4f7fb;--accent:#df5c35}
*{box-sizing:border-box}body{margin:0;background:var(--paper);color:var(--ink);font:14px -apple-system,BlinkMacSystemFont,'PingFang SC',sans-serif}button,textarea,select{font:inherit}button,a{touch-action:manipulation}button{cursor:pointer;border:1px solid var(--line);background:white;border-radius:9px;padding:10px 13px;color:var(--ink)}button:hover{border-color:var(--blue)}button:disabled{opacity:.45;cursor:default}:focus-visible{outline:3px solid #8eb8fa;outline-offset:3px}header{height:78px;padding:0 28px;display:flex;align-items:center;justify-content:space-between;background:white;border-bottom:1px solid var(--line);gap:20px}h1{font-size:20px;margin:0;font-weight:700}header p{margin:5px 0 0;color:var(--muted);font-size:12px}.brand{border-left:4px solid var(--blue);padding-left:13px}.layout{display:grid;grid-template-columns:220px minmax(320px,1fr) 320px;min-height:calc(100vh - 78px)}nav{padding:20px 14px;border-right:1px solid var(--line);background:#fbfcfe;max-height:calc(100vh - 78px);overflow:auto}nav h2,aside h2{font-size:13px;margin:0 0 17px;color:var(--muted);font-weight:500}nav button{display:block;width:100%;text-align:left;padding:11px 12px;border-color:transparent;background:transparent;margin-bottom:4px}nav button[aria-current=true]{background:#e7effc;border-color:#bbd1f3;color:var(--blue)}nav small{display:block;margin-top:4px;color:var(--muted);font-size:11px}.stage{padding:23px 24px 32px;min-width:0}.toolbar{display:flex;align-items:center;justify-content:space-between;gap:12px;margin-bottom:20px}.toolbar h2{font-size:17px;margin:0}.toolbar p{font-size:12px;color:var(--muted);margin:6px 0}.controls{display:flex;align-items:center;gap:8px;flex-shrink:0}select{padding:8px;border:1px solid var(--line);border-radius:7px;background:white}.viewport{overflow:auto;text-align:center;max-height:calc(100vh - 202px);padding:8px 24px 20px}.screen{position:relative;display:inline-block;vertical-align:top;line-height:0;width:auto;max-width:100%;box-shadow:0 12px 40px #21385518;border-radius:28px;isolation:isolate;background:white}.screen img{display:block;max-width:100%;max-height:calc(100vh - 242px);width:auto;height:auto;border-radius:28px}.screen.large{width:430px;max-width:none}.screen.large img{width:430px;max-height:none}.screen.annotating{cursor:crosshair}.pin{position:absolute;transform:translate(-50%,-50%);border:2px solid white;background:var(--accent);color:white;width:28px;height:28px;line-height:24px;padding:0;border-radius:50%;font-weight:700;box-shadow:0 2px 8px #0003}.pin.resolved{background:#758497}.pin.selected{outline:3px solid #ffbe9f}.hint{text-align:center;font-size:12px;color:var(--muted);margin:14px 0 0}.primary{background:var(--blue);color:white;border-color:var(--blue)}.primary.active{background:#17417e}aside{background:white;border-left:1px solid var(--line);padding:24px 20px;max-height:calc(100vh - 78px);overflow:auto}.aside-head{display:flex;justify-content:space-between;align-items:baseline}.count{font-size:12px;color:var(--muted)}.empty{padding:36px 4px;color:var(--muted);line-height:1.9}.empty strong{color:var(--ink);display:block;margin-bottom:7px;font-size:15px}.note{border:1px solid var(--line);border-radius:12px;padding:13px;margin-bottom:12px}.note.selected{border-color:var(--blue);background:#f7faff}.note p{line-height:1.7;margin:10px 0;white-space:pre-wrap;overflow-wrap:anywhere}.note-head{display:flex;justify-content:space-between;color:var(--muted);font-size:12px}.note-actions{display:flex;gap:5px;flex-wrap:wrap}.note-actions button{font-size:12px;padding:6px 8px}.editor{background:#f2f6fc;border:1px solid #bdd0eb;padding:14px;border-radius:12px;margin-bottom:18px}.editor label{display:block;margin-bottom:10px;font-weight:600}.editor textarea{resize:vertical;width:100%;min-height:130px;border:1px solid #bac9dd;border-radius:8px;padding:12px;line-height:1.7;background:white}.editor .actions{display:flex;gap:8px;margin-top:10px}.status{font-size:12px;color:var(--muted);padding:14px 0;line-height:1.6}.status.error{color:#ad3519}a{color:var(--blue);text-decoration:none}.export{font-size:13px}.subtle{font-size:11px;color:var(--muted);line-height:1.7;margin-top:20px}button.remove{color:#ad3519}[hidden]{display:none!important}
@media(max-width:1000px){.layout{grid-template-columns:170px minmax(260px,1fr) 280px}.stage{padding:20px 12px}.toolbar{align-items:flex-start;flex-direction:column}.viewport{padding:8px;max-height:calc(100vh - 240px)}header{padding:0 18px}}
@media(max-width:740px){header{height:auto;padding:18px;align-items:flex-start}.layout{display:block}nav{display:flex;overflow:auto;padding:10px;border-right:0;border-bottom:1px solid var(--line)}nav h2,nav small{display:none}nav button{white-space:nowrap;width:auto;margin:0}.toolbar{flex-direction:row}.viewport{max-height:65vh}.screen img{max-height:58vh}aside{max-height:none;border-left:0;border-top:1px solid var(--line)}.subtle{display:none}}
</style>
<header><div class="brand"><h1>__REVIEW_TITLE__</h1><p>逐页检查界面层级、视觉与操作路径，并把反馈直接标在画面上。</p></div><a class="export" id="export" href="feedback.md" download hidden>导出全部批注 ↗</a></header>
<div class="layout"><nav aria-label="评审页面"><h2>页面 / 状态</h2><div id="pages"></div></nav>
<main class="stage"><div class="toolbar"><div><h2 id="pageTitle"></h2><p id="pageDescription"></p></div><div class="controls"><select id="zoom" aria-label="截图缩放"><option value="fit">适应窗口</option><option value="large">放大查看</option></select><button id="annotate" class="primary" aria-pressed="false" disabled>＋ 添加批注</button></div></div>
<div class="viewport"><div class="screen" id="screen"><img id="screenshot" alt=""><div id="pins"></div></div></div><p class="hint" id="hint">先点「添加批注」，再点击截图上的位置。</p></main>
<aside><div class="aside-head"><h2>当前页面批注</h2><span id="count" class="count"></span></div>
<form id="editor" class="editor" hidden><label for="comment">这个位置需要怎么改？</label><textarea id="comment" maxlength="4000" placeholder="例如：标题和正文之间的间距再小一点。"></textarea><div class="actions"><button class="primary" id="save" type="submit">保存批注</button><button id="cancel" type="button">取消</button></div></form>
<div id="notes"></div><div id="status" class="status" role="status">正在读取批注…</div><p class="subtle">这是视觉评审画布；静态截图中的控件不可操作。<br>批注保存在本地项目；交互是否可用需在真实应用中验收。</p></aside></div>
<script>
const pages=__PAGES_JSON__;
const $=id=>document.getElementById(id);let feedback=[],current=pages[0],draft=null,selected=null,armed=false,busy=false,loaded=false;
const status=(text,error=false)=>{$('status').textContent=text;$('status').classList.toggle('error',error)};
function arm(value){armed=value;$('annotate').classList.toggle('active',value);$('annotate').setAttribute('aria-pressed',String(value));$('screen').classList.toggle('annotating',value);$('hint').textContent=value?'点击截图，标出你希望修改的位置。':'先点「添加批注」，再点击截图上的位置。'}
function discard(){draft=null;$('editor').hidden=true;$('comment').value='';arm(false);renderNotes()}
function choose(page){if(busy)return;if(draft&&$('comment').value.trim()&&!confirm('当前批注尚未保存，放弃并切换页面？'))return;current=page;selected=null;discard();$('pageTitle').textContent=page.title;$('pageDescription').textContent=page.description;$('screenshot').src='assets/'+page.source;$('screenshot').alt=page.title+'：'+page.description;document.querySelectorAll('[data-page]').forEach(b=>b.setAttribute('aria-current',String(b.dataset.page===page.id)));renderNotes()}
function edit(value,confirmed=false){if(busy)return;if(!confirmed&&draft&&$('comment').value.trim()&&!confirm('当前批注尚未保存，放弃并编辑另一条？'))return;draft={...value};selected=value.id;arm(false);$('editor').hidden=false;$('comment').value=value.text||'';renderNotes();$('comment').focus()}
function button(label,handler,cls=''){const b=document.createElement('button');b.textContent=label;b.className=cls;b.disabled=busy;b.onclick=handler;return b}
function renderNotes(){const notes=feedback.filter(n=>n.page===current.id);$('count').textContent=notes.length+' 条';$('notes').replaceChildren();$('pins').replaceChildren();$('export').hidden=!feedback.length;
if(!notes.length){const empty=document.createElement('div');empty.className='empty';const strong=document.createElement('strong');strong.textContent='把想法直接标在这里';empty.append(strong,document.createTextNode('点击截图添加第一条批注。字号、间距、颜色或布局，都可以具体指出。'));$('notes').append(empty)}
notes.forEach(n=>{const number=feedback.indexOf(n)+1;const pin=button(String(number),e=>{e.stopPropagation();selected=n.id;renderNotes();document.querySelector('[data-note="'+n.id+'"]')?.scrollIntoView({block:'nearest',behavior:'smooth'})},'pin'+(n.resolved?' resolved':'')+(n.id===selected?' selected':''));pin.style.left=n.x*100+'%';pin.style.top=n.y*100+'%';pin.setAttribute('aria-label','批注 '+number+'：'+n.text);$('pins').append(pin);
const card=document.createElement('article');card.className='note'+(n.id===selected?' selected':'');card.dataset.note=n.id;const head=document.createElement('div');head.className='note-head';const name=document.createElement('span');name.textContent='批注 '+number;const state=document.createElement('span');state.textContent=n.resolved?'已处理':'待处理';head.append(name,state);const text=document.createElement('p');text.textContent=n.text;const actions=document.createElement('div');actions.className='note-actions';actions.append(button('编辑',()=>edit(n)),button(n.resolved?'重新打开':'标为已处理',()=>persist(feedback.map(v=>v.id===n.id?{...v,resolved:!v.resolved}:v))),button('删除',()=>{if(confirm('删除这条批注？'))persist(feedback.filter(v=>v.id!==n.id))},'remove'));card.append(head,text,actions);$('notes').append(card)})}
async function persist(next){if(busy||!loaded)return false;busy=true;$('cancel').disabled=true;$('save').disabled=true;$('annotate').disabled=true;renderNotes();status('正在保存…');try{const r=await fetch('/api/feedback',{method:'POST',headers:{'Content-Type':'application/json'},body:JSON.stringify(next)});if(!r.ok)throw Error();feedback=next;status('已保存到项目 · '+new Date().toLocaleTimeString('zh-CN',{hour:'2-digit',minute:'2-digit'}));return true}catch{status('保存失败，输入仍在。请确认本地评审服务运行后重试。',true);return false}finally{busy=false;$('cancel').disabled=false;$('save').disabled=false;$('annotate').disabled=false;renderNotes()}}
pages.forEach(page=>{const b=button(page.title,()=>choose(page));b.dataset.page=page.id;const sub=document.createElement('small');sub.textContent=page.description;b.append(sub);$('pages').append(b)});
$('annotate').onclick=()=>{if(!loaded||busy)return;arm(!armed)};
$('screen').onclick=e=>{if(!armed||busy||!loaded)return;if(draft&&$('comment').value.trim()&&!confirm('放弃当前未保存批注，标记新位置？'))return;const r=$('screenshot').getBoundingClientRect();edit({id:crypto.randomUUID(),page:current.id,x:Math.max(0,Math.min(1,(e.clientX-r.left)/r.width)),y:Math.max(0,Math.min(1,(e.clientY-r.top)/r.height)),text:'',resolved:false},true)};
$('editor').onsubmit=async e=>{e.preventDefault();if(!draft)return;const text=$('comment').value.trim();if(!text){status('先写下你希望修改的内容。',true);$('comment').focus();return}const item={...draft,text};const next=feedback.some(v=>v.id===item.id)?feedback.map(v=>v.id===item.id?item:v):[...feedback,item];if(await persist(next)){selected=item.id;discard()}};
$('cancel').onclick=discard;$('zoom').onchange=()=>{$('screen').classList.toggle('large',$('zoom').value==='large')};
window.addEventListener('beforeunload',e=>{if(busy||(draft&&$('comment').value.trim())){e.preventDefault();e.returnValue=''}});
choose(current);fetch('/api/feedback',{cache:'no-store'}).then(r=>{if(!r.ok)throw Error();return r.json()}).then(data=>{feedback=data;loaded=true;$('annotate').disabled=false;renderNotes();status('批注保存在本地项目，可继续上次评审。')}).catch(()=>status('无法读取批注。请启动评审服务后刷新页面。',true));
</script></html>
